# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/
.vite/

# ── Environment & secrets — NEVER commit these ────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials
aws-credentials

# ── Terraform state & secrets ─────────────────────────────────────────────────
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/terraform.tfvars
terraform/*.tfvars
terraform/*.tfvars.json
# Keep example variable files
!terraform/*.tfvars.example

# ── OS & editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.logs/

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── TypeScript ────────────────────────────────────────────────────────────────
*.tsbuildinfo
