# ─────────────────────────────────────────────────────────────────────────────
# Grafana Cloud credentials
#
# Copy this file to secrets.auto.tfvars and fill in your real values.
# The .auto.tfvars suffix causes Terraform to load it automatically.
# secrets.auto.tfvars is gitignored — never commit real credentials.
#
# How to get these values:
#   1. Log in at grafana.com and open your Cloud Portal (grafana.com/orgs/<your-org>)
#   2. Find your stack and click the Loki tile → "Details"
#   3. Copy the URL shown (e.g. https://logs-prod-006.grafana.net)
#      Append /loki/api/v1/push  → that is your grafana_cloud_loki_url
#   4. Copy the User value (a numeric ID) → grafana_cloud_loki_username
#   5. Under your avatar → My Profile → Security → API keys
#      Create a new key with the "MetricsPublisher" role
#      Paste the generated key → grafana_cloud_loki_password
# ─────────────────────────────────────────────────────────────────────────────

grafana_cloud_loki_url      = "https://logs-prod-XXX.grafana.net/loki/api/v1/push"
grafana_cloud_loki_username = "123456"
grafana_cloud_loki_password = "your-grafana-cloud-api-key"
