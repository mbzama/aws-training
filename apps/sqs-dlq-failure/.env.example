# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# SQS Queue URLs
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/orders-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/<account-id>/orders-dlq

# LocalStack endpoint (leave empty for real AWS)
# AWS_ENDPOINT_URL=http://localhost:4566
