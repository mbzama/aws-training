{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": false,
    "outDir": "./dist",
    "target": "es2020",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/workers/**/*.ts", "src/scripts/**/*.ts", "src/lib/**/*.ts"],
  "exclude": ["node_modules"]
}
