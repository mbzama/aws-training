terraform {
  required_version = ">= 1.5"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = ">= 3.5"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}

# ---------------------------------------------------------------
# Stable 8-char suffix — equivalent to the MD5 hash of the stack
# ID used in CloudFormation to produce unique resource identifiers.
# Keyed on stack_name so it regenerates only when the name changes.
# ---------------------------------------------------------------

resource "random_id" "suffix" {
  byte_length = 4

  keepers = {
    stack_name = var.stack_name
  }
}

# ---------------------------------------------------------------
# Secrets Manager — passwords are generated by Terraform and stored
# as plain-string secrets (mirrors CloudFormation GenerateSecretString
# with no SecretStringTemplate).
# ---------------------------------------------------------------

resource "random_password" "redshift" {
  length           = 32
  special          = true
  override_special = "!#$^&*()_+-=[]{}|;':,.<>?" # excludes " @ / \ %
}

resource "random_password" "postgres" {
  length           = 32
  special          = true
  override_special = "!#$^&*()_+-=[]{}|;':,.<>?" # excludes " @ / \ %
}

resource "aws_secretsmanager_secret" "redshift_master" {
  name        = "${var.stack_name}-redshift-master"
  description = "Redshift cluster master credentials"
}

resource "aws_secretsmanager_secret_version" "redshift_master" {
  secret_id     = aws_secretsmanager_secret.redshift_master.id
  secret_string = random_password.redshift.result
}

resource "aws_secretsmanager_secret" "postgres_master" {
  name        = "${var.stack_name}-postgres-master"
  description = "PostgreSQL RDS master credentials"
}

resource "aws_secretsmanager_secret_version" "postgres_master" {
  secret_id     = aws_secretsmanager_secret.postgres_master.id
  secret_string = random_password.postgres.result
}

# ---------------------------------------------------------------
# Security Groups
# ---------------------------------------------------------------

resource "aws_security_group" "redshift" {
  name        = "${var.stack_name}-redshift-sg"
  description = "Redshift - allow port 5439 inbound from within the VPC"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "Redshift from anywhere (JDBC/ODBC clients, SQL tools) — restrict to your IP in production"
    from_port   = 5439
    to_port     = 5439
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"] # Open for sandbox; restrict to your IP in real use
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.stack_name}-redshift-sg"
  }
}

resource "aws_security_group" "postgres" {
  name        = "${var.stack_name}-postgres-sg"
  description = "PostgreSQL RDS - allow port 5432 from Redshift cluster only"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description     = "PostgreSQL from Redshift cluster"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.redshift.id]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.stack_name}-postgres-sg"
  }
}

# ---------------------------------------------------------------
# Redshift Single-Node Cluster
# ---------------------------------------------------------------

resource "aws_redshift_subnet_group" "main" {
  name        = "${var.stack_name}-redshift-subnet-group"
  description = "Subnet group for ${var.stack_name} Redshift cluster"
  subnet_ids  = data.aws_subnets.default.ids

  tags = {
    Name = "${var.stack_name}-redshift-subnet-group"
  }
}

resource "aws_redshift_cluster" "main" {
  cluster_identifier = "redshift-${random_id.suffix.hex}"
  cluster_type       = "single-node"
  number_of_nodes    = 1
  node_type          = var.node_type
  availability_zone  = "us-east-1a"

  database_name   = var.db_name
  master_username = var.db_username
  master_password = random_password.redshift.result

  vpc_security_group_ids   = [aws_security_group.redshift.id]
  cluster_subnet_group_name = aws_redshift_subnet_group.main.name

  publicly_accessible              = true
  encrypted                        = true
  automated_snapshot_retention_period = 1
  allow_version_upgrade            = true
  preferred_maintenance_window     = "sun:05:00-sun:06:00"

  skip_final_snapshot = true # mirrors DeletionPolicy: Delete

  tags = {
    Name = "${var.stack_name}-cluster"
  }
}

# ---------------------------------------------------------------
# PostgreSQL RDS (db.t3.medium)
# Connected to Redshift via security group on port 5432
# ---------------------------------------------------------------

resource "aws_db_subnet_group" "postgres" {
  name        = "${var.stack_name}-postgres-subnet-group"
  description = "Subnet group for ${var.stack_name} PostgreSQL RDS"
  subnet_ids  = data.aws_subnets.default.ids

  tags = {
    Name = "${var.stack_name}-postgres-subnet-group"
  }
}

resource "aws_db_instance" "postgres" {
  identifier        = "postgres-${random_id.suffix.hex}"
  instance_class    = "db.t3.medium"
  engine            = "postgres"
  engine_version    = "17.2"
  username          = var.pg_username
  password          = random_password.postgres.result
  db_name           = var.pg_db_name

  allocated_storage     = 20
  max_allocated_storage = 50
  storage_type          = "gp3"
  storage_encrypted     = false

  multi_az               = false
  publicly_accessible    = false
  vpc_security_group_ids = [aws_security_group.postgres.id]
  db_subnet_group_name   = aws_db_subnet_group.postgres.name

  backup_retention_period = 0   # Backups disabled for testing
  deletion_protection     = false
  skip_final_snapshot     = true # mirrors DeletionPolicy: Delete

  tags = {
    Name = "${var.stack_name}-postgres"
  }
}
