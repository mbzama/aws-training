# AWS credentials used to call the Translate API.
# All of these are OPTIONAL. If left blank, the AWS SDK's default credential
# provider chain is used instead, which resolves credentials from (in order):
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN exported
#      directly in the terminal that starts this app.
#   2. The AWS_PROFILE named below, read from your local ~/.aws/credentials
#      and ~/.aws/config (e.g. set up via `aws configure` or `aws sso login`).
#   3. An EC2/ECS/Lambda instance role, when running in AWS.
#
# "Client ID" / "Client secret" map to an IAM user's access key pair.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
AWS_REGION=us-east-1

# Name of the custom terminology resource managed by this service.
TERMINOLOGY_NAME=exclude-list-v1

PORT=3000
